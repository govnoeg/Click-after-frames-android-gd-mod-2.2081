{
  "geode": "4.0.0",
  "gd": {
    "win": "2.2081",
    "android32": "2.2081",
    "android64": "2.2081",
    "mac": "2.2081"
  },
  "id": "yourname.click-timing",
  "name": "Click Timing",
  "version": "v1.0.0",
  "developer": "yourname",
  "description": "Sets how many milliseconds after a tap the click is played. Works on Android.",
  "settings": {
    "enabled": {
      "type": "bool",
      "name": "Enabled",
      "default": true
    },
    "delay-ms": {
      "type": "int",
      "name": "Click delay (ms)",
      "description": "How many milliseconds after a tap the click is played.",
      "default": 5,
      "min": 0,
      "max": 500,
      "control": { "slider": true }
    },
    "only-in-level": {
      "type": "bool",
      "name": "Only in level",
      "default": true
    }
  }
}

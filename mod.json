{
  "geode": "5.11.2",
  "gd": {
    "android": "2.2081",
    "win": "2.2081"
  },
  "id": "icedkey.click-timing",
  "name": "Click Timing",
  "version": "v1.1.0",
  "developer": "IceDKey",
  "description": "Delays your click by milliseconds or frames. Works on Android.",
  "settings": {
    "enabled": {
      "type": "bool",
      "name": "Enabled",
      "default": true
    },
    "use-frames": {
      "type": "bool",
      "name": "Use frames",
      "description": "Delay in frames instead of milliseconds.",
      "default": false
    },
    "delay-ms": {
      "type": "int",
      "name": "Delay (ms)",
      "default": 5,
      "min": 0,
      "max": 500,
      "control": { "slider": true }
    },
    "delay-frames": {
      "type": "int",
      "name": "Delay (frames)",
      "default": 1,
      "min": 0,
      "max": 30,
      "control": { "slider": true }
    },
    "only-in-level": {
      "type": "bool",
      "name": "Only in level",
      "default": true
    }
  }
}
